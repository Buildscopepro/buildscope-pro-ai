{
  "name": "buildscope-pro-ai",
  "version": "5.15.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "web": "expo start --web",
    "doctor": "npx expo-doctor",
    "preflight": "node scripts/preflight.js",
    "build:android:preview": "eas build --platform android --profile preview",
    "build:android:production": "eas build --platform android --profile production",
    "server:check": "cd server && npm run check",
    "server:start": "cd server && npm start",
    "production-check": "node scripts/production-check.js",
    "bootstrap": "node scripts/bootstrap.js",
    "verify-env": "node scripts/verify-env.js",
    "check:backend": "node scripts/check-backend.js",
    "check:supabase": "node scripts/check-supabase.js",
    "check:all": "npm run verify-env && npm run preflight && npm run production-check",
    "source-audit": "node scripts/source-audit.js",
    "release-gate": "npm run preflight && npm run production-check && npm run source-audit && npm run qa:manifest",
    "qa:manifest": "node scripts/qa-manifest.js",
    "smoke": "node scripts/smoke.js",
    "qa:all": "npm run release-gate && npm run smoke",
    "check:live-supabase": "node scripts/check-live-supabase.js"
  },
  "dependencies": {
    "expo": "^57.0.0",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "expo-notifications": "~57.0.12",
    "@supabase/supabase-js": "latest",
    "react-native-url-polyfill": "latest",
    "@react-native-async-storage/async-storage": "2.2.0",
    "react-native-maps": "1.20.1",
    "expo-location": "~57.0.5",
    "expo-image-picker": "~57.0.5",
    "@stripe/stripe-react-native": "0.64.0",
    "expo-constants": "~57.0.12"
  }
}